    "@prisma/client": "^6.17.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "prisma": "^6.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
