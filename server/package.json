{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npm run build && npm run start",
    "dev:w": "nodemon -e ts --ignore dist/ --exec \"npm run build && npm start\"",
    "prisma:generate": "DOTENV_CONFIG_PATH=.env.local prisma generate",
    "prisma:migrate": "DOTENV_CONFIG_PATH=.env.local prisma migrate dev",
    "prisma:reset": "DOTENV_CONFIG_PATH=.env.local prisma migrate reset"
  },
  "keywords": [],
